-- PLAYER_SHOP_TWO_BLOCKS_KEYS2_V1
quest shop_unlock_slots begin
    state start begin
        when 30376.use begin
            local progress = pc.get_special_flag("shop_unlock_slot")
            if progress >= 20 then
                syschat("Wszystkie pola odblokowywane kluczem sa juz dostepne.")
                return
            end
            local cost = 1
            if progress >= 4 then cost = 2 end
            if pc.count_item(30376) < cost then
                if cost == 2 then
                    syschat("Do odblokowania kolejnych 5 pol potrzebujesz 2 Drewnianych Kluczy.")
                else
                    syschat("Potrzebujesz jednego Drewnianego Klucza.")
                end
                return
            end
            pc.remove_item(30376, cost)
            pc.set_special_flag("shop_unlock_slot", progress + 1)
            syschat("Odblokowano kolejne 5 pol sklepu.")
        end
    end
end
