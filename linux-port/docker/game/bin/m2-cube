#!/bin/sh
# =============================================================================
#  m2-cube -- the crafting recipes (cube.txt) as the Seban panel's
#  "Wytwarzanie (cube)" page (database editor, dbeditor/cube.py) saved them
#  (MT2009_PLUS_DB_EDITOR_CUBE_V1).
#
#  Every core reads $LOCALE_DIR/cube.txt while it boots (cube.cpp Cube_init).
#  The file lives in the image (the Dockerfile appends Seon-Pyeong's recipes),
#  so an edit made in the container would be lost on the next update.
#
#  The panel therefore writes the whole file (the image's file with the
#  operator's recipes changed / added / removed) into the spool volume both
#  containers share:
#      $SPOOL/cube/cube.custom.txt
#  and before the cores boot (m2-supervise, boot_cores) `apply' puts it in
#  place of the live file. No file means the image's recipes. The image's file
#  goes back to the panel as $SPOOL/cube/cube.base.txt, the NPCs whose quest
#  opens the cube window (command("cube open")) as $SPOOL/cube/cube_npcs.txt;
#  how the last apply went: $SPOOL/cube/status (state, time, groups, sha,
#  message - like m2-dragonsoul).
#
#  Checked before anything is used (a failing file is not used at all, the
#  cores boot with the image's recipes and the panel is told why) - what would
#  crash Cube_load / Cube_InformationInitialize or break the client's window:
#    * at most 512 KB, no line over 254 characters (fgets(256));
#    * every npc/item/reward/percent/gold line inside section ... end;
#    * a recipe has an NPC (1-65535), 1-5 ingredients, a reward, counts
#      1-200, percent 0-100, gold 0-2000000000, numbers only;
#    * every item is in item_proto and every NPC in mob_proto (when the
#      database answers).
#
#  Subcommands
#      prepare   as root, at container start: keep the image's file, make the
#                live one writable by the service account, the spool folder
#      apply     put the panel's recipes in place (run by m2-supervise before a boot)
# =============================================================================
set -u
LC_ALL=C
export LC_ALL

SHARE_DIR="${M2_SHARE_DIR:-/opt/metin2/share}"
VAR_DIR="${M2_VAR_DIR:-/opt/metin2/var}"
LOCALE_DIR="$SHARE_DIR/locale/${M2_LOCALE_NAME:-poland}"
SPOOL="${M2_RATES_SPOOL:-/opt/m2spool}/cube"

LIVE="$LOCALE_DIR/cube.txt"
IMAGE="$LOCALE_DIR/cube.image.txt"
CUSTOM="$SPOOL/cube.custom.txt"
STATUS="$SPOOL/status"
WORK="$VAR_DIR/cube"
MAX_BYTES=524288

say() { printf '%s [cube] %s\n' "$(date -u '+%Y-%m-%d %H:%M:%SZ')" "$1"; }

write_status() { # write_status STATE RECIPES SHA MESSAGE
    _tmp="$STATUS.new.$$"
    { printf 'state=%s\n' "$1"
      printf 'time=%s\n' "$(date +%s 2>/dev/null)"
      printf 'groups=%s\n' "$2"
      printf 'sha=%s\n' "$3"
      printf 'message=%s\n' "$4"
    } > "$_tmp" 2>/dev/null || { rm -f "$_tmp"; return 1; }
    chmod 0664 "$_tmp" 2>/dev/null
    mv -f "$_tmp" "$STATUS" 2>/dev/null || rm -f "$_tmp"
    return 0
}

publish() { # publish SOURCE NAME -- a read-only copy for the panel
    [ -d "$SPOOL" ] && [ -f "$1" ] || return 0
    cmp -s "$1" "$SPOOL/$2" && return 0
    cp "$1" "$SPOOL/$2.new.$$" 2>/dev/null && chmod 0664 "$SPOOL/$2.new.$$" 2>/dev/null \
        && mv -f "$SPOOL/$2.new.$$" "$SPOOL/$2" 2>/dev/null || rm -f "$SPOOL/$2.new.$$"
}

# The NPCs a quest opens the window for: compiled quest scripts under
# quest/object/<npc vnum>/ that say command("cube open").
publish_openers() {
    [ -d "$SPOOL" ] && [ -d "$LOCALE_DIR/quest/object" ] || return 0
    mkdir -p "$WORK" 2>/dev/null
    for _d in "$LOCALE_DIR"/quest/object/*/; do
        _n=$(basename "$_d")
        case "$_n" in *[!0-9]*|'') continue ;; esac
        grep -rqs 'cube open' "$_d" && printf '%s\n' "$_n"
    done > "$WORK/openers.txt" 2>/dev/null
    # CUSTOM_UKRAINKA_CUBE_GROUPS_V1
    if grep -qx '30099' "$WORK/openers.txt"; then
        printf '%s\n' 65000 65001 >> "$WORK/openers.txt"
    fi
    publish "$WORK/openers.txt" cube_npcs.txt
}

# The live file is rewritten in place: the folder belongs to root, the file
# itself to the service account (prepare).
put_live() { # put_live SOURCE
    cmp -s "$1" "$LIVE" && return 0
    cat "$1" > "$LIVE"
}

db_query() { # db_query SQL -- rows on stdout; non-zero when the database did not answer
    command -v mariadb >/dev/null 2>&1 || return 2
    MYSQL_PWD="${M2_DB_PASSWORD:-}" mariadb -h "${M2_DB_HOST:-mariadb}" -P "${M2_DB_PORT:-3306}" \
        -u "${M2_DB_USER:-metin2}" -N -B --connect-timeout=10 -e "$1" 2>/dev/null
}

reject() { # reject SHA WHY
    say "the panel's crafting recipes were NOT used: $2"
    put_live "$IMAGE"
    write_status rejected 0 "$1" "$2"
    return 0
}

# check FILE -- "I <item>", "N <npc>", "R <recipes>" or "E <why>" (the first error)
check() {
    awk '
    function err(m) { print "E line " NR ": " m; bad = 1; exit }
    function isnum(s) { return s ~ /^[0-9]+$/ && length(s) <= 10 }
    {
        line = $0; sub(/\r$/, "", line)
        if (length(line) > 254) err("longer than 254 characters")
        if (substr(line, 1, 1) == "#") next
        n = split(line, t, /[ \t\r]+/)
        if (n && t[1] == "") { for (i = 2; i <= n; i++) t[i - 1] = t[i]; n-- }
        if (n == 0) next
        w = tolower(t[1])
        if (w == "section") {
            if (open) err("section inside a section (end missing)")
            open = 1; npcs = 0; items = 0; rewards = 0; next
        }
        if (w != "npc" && w != "item" && w != "reward" && w != "percent" && w != "gold" && w != "end") next
        if (!open) err(w " outside a section")
        if (w == "end") {
            if (!npcs) err("a recipe without npc")
            if (!items) err("a recipe without items")
            if (items > 5) err("more than 5 items (the cube window shows 5)")
            if (!rewards) err("a recipe without reward")
            open = 0; recipes++; next
        }
        if (!isnum(t[2])) err(w " needs a number")
        if (w == "npc") {
            if (t[2] + 0 < 1 || t[2] + 0 > 65535) err("npc must be 1-65535")
            npcs++; print "N " t[2] + 0; next
        }
        if (w == "percent") { if (t[2] + 0 > 100) err("percent must be 0-100"); next }
        if (w == "gold") { if (t[2] + 0 > 2000000000) err("gold must be 0-2000000000"); next }
        if (!isnum(t[3])) err(w " needs a count")
        if (t[2] + 0 < 1) err("item 0")
        if (t[3] + 0 < 1 || t[3] + 0 > 200) err("count must be 1-200")
        if (w == "item") items++; else rewards++
        print "I " t[2] + 0
    }
    END {
        if (bad) exit
        if (open) { print "E a section is not closed (end missing)"; exit }
        if (!recipes) { print "E no recipes"; exit }
        print "R " recipes
    }
    ' "$1"
}

# missing TABLE WANTED -- the numbers of WANTED (comma list) TABLE does not
# have; returns 2 when the database did not answer
missing() {
    db_query "SELECT vnum FROM player.$1${M2_TABLE_POSTFIX:-} WHERE vnum IN ($2)" > "$WORK/found" || return 2
    printf '%s\n' "$2" | tr ',' '\n' | sort -u > "$WORK/wanted"
    sort -u "$WORK/found" | comm -23 "$WORK/wanted" - | tr '\n' ' '
}

cmd_prepare() {
    [ -f "$LIVE" ] || { say "no $LIVE -- nothing to prepare"; return 0; }
    # The first start of a container: the file is still the image's.
    [ -f "$IMAGE" ] || cp -p "$LIVE" "$IMAGE" || return 1
    chown metin2:metin2 "$LIVE" 2>/dev/null
    chmod 0644 "$LIVE" 2>/dev/null
    mkdir -p "$WORK" 2>/dev/null && chown metin2:metin2 "$WORK" 2>/dev/null
    if mkdir -p "$SPOOL" 2>/dev/null; then
        chgrp m2spool "$SPOOL" 2>/dev/null && chmod 2770 "$SPOOL" 2>/dev/null
        chgrp -R m2spool "$SPOOL"/* 2>/dev/null
        chmod g+rw "$SPOOL"/* 2>/dev/null
    fi
    return 0
}

cmd_apply() {
    [ -f "$IMAGE" ] || { say "no $IMAGE (m2-cube prepare did not run) -- recipes left as the image has them"; return 0; }
    mkdir -p "$WORK" 2>/dev/null
    publish "$IMAGE" cube.base.txt
    publish_openers

    if [ ! -s "$CUSTOM" ] || ! grep -q '^section' "$CUSTOM"; then
        put_live "$IMAGE" || { say "could not write $LIVE"; return 1; }
        write_status base 0 "" "no change in the panel -- the image's cube.txt is live"
        return 0
    fi
    _sha=$(sha256sum "$CUSTOM" | cut -d' ' -f1)
    _size=$(wc -c < "$CUSTOM" | tr -d ' ')
    [ "$_size" -le "$MAX_BYTES" ] || { reject "$_sha" "the file is larger than $MAX_BYTES bytes"; return 0; }

    check "$CUSTOM" > "$WORK/custom.check" 2>&1
    _why=$(sed -n 's/^E //p' "$WORK/custom.check" | head -1)
    [ -n "$_why" ] && { reject "$_sha" "$_why"; return 0; }
    _recipes=$(sed -n 's/^R //p' "$WORK/custom.check" | head -1)
    [ -n "$_recipes" ] || { reject "$_sha" "the file could not be checked"; return 0; }

    _items=$(sed -n 's/^I //p' "$WORK/custom.check" | sort -un | tr '\n' ',' | sed 's/,$//')
    _npcs=$(sed -n 's/^N //p' "$WORK/custom.check" | awk '{ if ($1 == 65000 || $1 == 65001) print 30099; else print $1 }' | sort -un | tr '\n' ',' | sed 's/,$//')
    if _m=$(missing item_proto "$_items"); then
        [ -n "$(printf '%s' "$_m" | tr -d ' ')" ] && { reject "$_sha" "no such item: $_m"; return 0; }
        if _m=$(missing mob_proto "$_npcs"); then
            [ -n "$(printf '%s' "$_m" | tr -d ' ')" ] && { reject "$_sha" "no such npc: $_m"; return 0; }
        fi
    else
        say "could not check the item and NPC numbers against the database -- trusting the panel's check"
    fi

    if ! put_live "$CUSTOM"; then
        say "could not write $LIVE -- recipes left as they were"
        write_status failed 0 "$_sha" "the game container could not write cube.txt"
        return 1
    fi
    say "crafting recipes from the panel applied ($_recipes recipes)"
    write_status ok "$_recipes" "$_sha" "applied: $_recipes recipes from the panel"
    return 0
}

case "${1:-}" in
    prepare) cmd_prepare ;;
    apply)   cmd_apply ;;
    *) echo "usage: m2-cube prepare|apply"; exit 1 ;;
esac
