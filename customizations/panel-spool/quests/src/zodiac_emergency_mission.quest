				return
			end
			say("Witam! Mam dla ciebie prezent, ale najpierw muszê[ENTER]poprosiæ ciê o przys³ugê. W Œwi¹tyni Zodiaku[ENTER]gwa³townie wzros³a moc mrocznej energii. Na[ENTER]szczêœcie mo¿na j¹ absorbowaæ za pomoc¹[ENTER]Animosfer. Udaj siê do œwi¹tyni i u¿yj 24[ENTER]Animosfer, by ponownie obni¿yæ poziom energii.[ENTER]Uwaga: nie mo¿esz ukoñczyæ misji, jeœli masz[ENTER]aktywowany znak stra¿nika.") --10165
			wait()
			say_title("Alarm w Œwi¹tyni Zodiaku") --10163
			if pc.get_animasphere() < 24 then
				say(mob_name(20438))
				say("Wróæ, gdy bêdziesz mia³ co najmniej 24 Animosfery.")
