			if 0!=v then
				target.vid("__TARGET2__", v, mob_name(20438))
			end
			send_letter("Alarm w Œwi¹tyni Zodiaku") --10163
		end
		when login with (pc.get_animasphere() <= pc.getf("zodiac_emergency_mission", "animasphere_info")) begin
			pc.setf("zodiac_emergency_mission", "animasphere_complete", 1)
		end
		when button or info begin
			say_title("Alarm w Œwi¹tyni Zodiaku") --10163
			if pc.getf("zodiac_emergency_mission", "animasphere_complete") == 1 then
				say("Gotowe! Wróæ do Mnicha Milbon, by odebraæ prezent.") --10168
				say_reward("Zagadaj do NPC ze strza³k¹ nad g³ow¹. Migaj¹cy[ENTER]punkt na minimapie poka¿e ci, gdzie go mo¿esz[ENTER]znaleŸæ.") --10208
			else
				say("U¿yj Animosfer, by obni¿yæ mroczn¹ energiê w[ENTER]Œwi¹tyni Zodiaku zanim bêdzie za póŸno. Wchodz¹c[ENTER]do œwi¹tyni, zu¿ywasz automatycznie Animosfery.[ENTER]Uwaga: nie mo¿esz ukoñczyæ misji, jeœli masz[ENTER]aktywowany znak stra¿nika.") --10167
